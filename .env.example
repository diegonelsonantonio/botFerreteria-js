# ========================================
# CONFIGURACIÓN DEL BOT FERRETERÍA
# ========================================
# Copia este archivo a .env y completa con tus credenciales

# ========================================
# META (FACEBOOK/WHATSAPP)
# ========================================
# Token de verificación del webhook (puedes usar cualquier string)
META_VERIFY_TOKEN=tu_token_secreto_aqui

# Token de acceso de la página de Facebook
# Obtenerlo en: https://developers.facebook.com/apps
META_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App Secret de Meta para verificar firmas
# Encontrarlo en: Settings > Basic > App Secret
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========================================
# MONGODB ATLAS
# ========================================
# URI de conexión completa
# Formato: mongodb+srv://usuario:password@cluster.mongodb.net/
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos
DB_NAME=ferreteria_db

# Usuario de la base de datos
DB_USER=usuario_db

# Contraseña de la base de datos
DB_PASSWORD=password_seguro

# ========================================
# OPENAI
# ========================================
# API Key de OpenAI
# Obtenerla en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========================================
# PINECONE (OPCIONAL - PARA RAG)
# ========================================
# API Key de Pinecone
# PINECONE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Environment de Pinecone
# PINECONE_ENVIRONMENT=us-east-1-aws

# Nombre del índice
# PINECONE_INDEX=ferreteria-knowledge

# ========================================
# SERVIDOR
# ========================================
# Puerto del servidor (8080 para Cloud Run)
PORT=8080

# Entorno (development, production)
NODE_ENV=development

# ========================================
# REDIS (OPCIONAL - PARA MEJORAS FUTURAS)
# ========================================
# URL de conexión a Redis
# REDIS_URL=redis://localhost:6379

# ========================================
# GOOGLE CLOUD (PARA DESPLIEGUE)
# ========================================
# ID del proyecto de GCP
# GCP_PROJECT_ID=tu-proyecto-gcp

# Región de Cloud Run
# GCP_REGION=us-central1

# ========================================
# CONFIGURACIÓN ADICIONAL
# ========================================
# Nivel de logging (error, warn, info, debug)
# LOG_LEVEL=info

# Timeout para respuestas de OpenAI (ms)
# OPENAI_TIMEOUT=30000

# Máximo de mensajes en contexto
# MAX_CONTEXT_MESSAGES=10
